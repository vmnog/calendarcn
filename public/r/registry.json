      "css": {
        "@utility scrollbar-hide": {
          "-ms-overflow-style": "none",
          "scrollbar-width": "none",
          "&::-webkit-scrollbar": {
            "display": "none"
          }
        },
        "@layer base": {
          "[data-event-id], [data-event-id] *": {
            "cursor": "var(--cursor, default)"
          }
        },
        "@keyframes column-highlight-fade": {
          "from": {
            "background-color": "var(--calendar-highlight)"
          },
          "to": {
            "background-color": "transparent"
          }
        },
        ".column-highlight": {
          "animation": "column-highlight-fade 2s ease-out forwards"
        },
        "@keyframes calendar-loading-slide": {
          "from": {
            "transform": "translateX(-100%)"
          },
          "to": {
            "transform": "translateX(300%)"
          }
        },
        ".calendar-loading-bar": {
          "width": "33.333%",
          "animation": "calendar-loading-slide 1.2s cubic-bezier(0.65, 0, 0.35, 1) infinite"
        },
        "@media (prefers-reduced-motion: reduce)": {
          ".column-highlight": {
            "animation": "none",
            "background-color": "var(--calendar-highlight)"
          },
          ".calendar-loading-bar": {
            "width": "100%",
            "opacity": "0.5",
            "animation": "none"
          }
        }
      }
