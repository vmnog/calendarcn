      "cssVars": {
        "theme": {
          "text-xxs": "0.625rem"
        },
        "light": {
          "event-red": "#b23e31",
          "event-red-border": "#ee000e",
          "event-red-bg": "#ffe1d4",
          "event-orange": "#ad4517",
          "event-orange-border": "#fe7132",
          "event-orange-bg": "#ffe3c8",
          "event-yellow": "#855100",
          "event-yellow-border": "#f2b827",
          "event-yellow-bg": "#fff0be",
          "event-green": "#027b27",
          "event-green-border": "#49ca81",
          "event-green-bg": "#deffe3",
          "event-blue": "#006cbf",
          "event-blue-border": "#32a5e5",
          "event-blue-bg": "#e2f9ff",
          "event-purple": "#7733d2",
          "event-purple-border": "#9950ff",
          "event-purple-bg": "#feecff",
          "event-gray": "#5f6061",
          "event-gray-border": "#b3b4b4",
          "event-gray-bg": "#f6f4f3",
          "calendar-weekend": "#fcfcfc",
          "calendar-current-week": "#edece9",
          "calendar-day-hover": "#eeece8",
          "calendar-day-hover-current-week": "#e2e1dc"
        },
        "dark": {
          "event-red": "#d85140",
          "event-red-border": "#d85140",
          "event-red-bg": "#6c2920",
          "event-orange": "#e07040",
          "event-orange-border": "#e07040",
          "event-orange-bg": "#5f3524",
          "event-yellow": "#d4a83a",
          "event-yellow-border": "#d4a83a",
          "event-yellow-bg": "#4e3f1b",
          "event-green": "#52b577",
          "event-green-border": "#52b577",
          "event-green-bg": "#2d4935",
          "event-blue": "#4895c8",
          "event-blue-border": "#4895c8",
          "event-blue-bg": "#2f4656",
          "event-purple": "#8a5ad6",
          "event-purple-border": "#8a5ad6",
          "event-purple-bg": "#483a63",
          "event-gray": "#a0a0a0",
          "event-gray-border": "#a0a0a0",
          "event-gray-bg": "#424242",
          "calendar-weekend": "#181818",
          "calendar-current-week": "#2e2e2e",
          "calendar-day-hover": "#2e2e2e",
          "calendar-day-hover-current-week": "#3d3d3d"
        }
      },
      "css": {
        "@utility scrollbar-hide": {
          "-ms-overflow-style": "none",
          "scrollbar-width": "none",
          "&::-webkit-scrollbar": {
            "display": "none"
          }
        },
        "@layer base": {
          "[data-event-id], [data-event-id] *": {
            "cursor": "var(--cursor, default)"
          }
        },
        "@keyframes column-highlight-fade": {
          "from": {
            "background-color": "#602c2b"
          },
          "to": {
            "background-color": "transparent"
          }
        },
        ".column-highlight": {
          "animation": "column-highlight-fade 2s ease-out forwards"
        },
        "@keyframes calendar-loading-slide": {
          "from": {
            "transform": "translateX(-100%)"
          },
          "to": {
            "transform": "translateX(300%)"
          }
        },
        ".calendar-loading-bar": {
          "width": "33.333%",
          "animation": "calendar-loading-slide 1.2s cubic-bezier(0.65, 0, 0.35, 1) infinite"
        },
        "@media (prefers-reduced-motion: reduce)": {
          ".column-highlight": {
            "animation": "none",
            "background-color": "#602c2b"
          },
          ".calendar-loading-bar": {
            "width": "100%",
            "opacity": "0.5",
            "animation": "none"
          }
        }
      }
    },
